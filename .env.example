# Copy to .env in repository root. Never commit .env.
POSTGRES_PASSWORD=echonote-local-only
MINIO_ROOT_USER=echonote
MINIO_ROOT_PASSWORD=echonote-local-storage-only
GNANI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
GNANI_URL=https://api.vachana.ai/stt/v3
# Set the real repository URL before submission.
REPOSITORY_URL=
# Empty frontend API base uses the same-origin gateway (recommended).
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=["http://localhost:8080"]
# Browser-visible object endpoint. Change this for production.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MAX_UPLOAD_BYTES=262144000
MAX_DURATION_SECONDS=14400
MAX_ATTEMPTS=3
STALE_SECONDS=900
