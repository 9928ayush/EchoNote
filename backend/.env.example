# For native backend development only. Compose sets infrastructure URLs itself.
DATABASE_URL=postgresql+psycopg://echonote:echonote-local-only@localhost:5432/echonote
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=echonote
S3_ACCESS_KEY=echonote
S3_SECRET_KEY=echonote-local-storage-only
GNANI_API_KEY=
GNANI_URL=https://api.vachana.ai/stt/v3
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
REPOSITORY_URL=
MAX_UPLOAD_BYTES=262144000
MAX_DURATION_SECONDS=14400
MAX_ATTEMPTS=3
STALE_SECONDS=900
